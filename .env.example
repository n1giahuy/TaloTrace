# ADK / Gemini 3.1 Flash-Lite
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite

# Veo 3.1 Lite is regional.
VEO_MODEL=veo-3.1-lite-generate-001
VEO_LOCATION=us-central1
VEO_DURATION_SECONDS=8
VEO_ASPECT_RATIO=16:9
VEO_RESOLUTION=720p
VEO_POLL_SECONDS=10

# Optional. Leave empty for direct SDK download. If direct download is not
# available for your project/model access, set a writable prefix such as:
# VEO_OUTPUT_GCS_URI=gs://your-bucket/chemistry-videos
VEO_OUTPUT_GCS_URI=

ARTIFACT_DIR=/app/artifacts
